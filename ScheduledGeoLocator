# Format location info for output
function Format-LocationInfo {
    param(
        [string]$SectionTitle,
        [hashtable]$LocationInfo
    )
    $msg = @()
    $msg += "${SectionTitle}:"
    $msg += "IP Address: $($LocationInfo.IP)"
    $msg += "ISP: $($LocationInfo.ISP)"
    $msg += "Latitude: $($LocationInfo.Latitude)"
    $msg += "Longitude: $($LocationInfo.Longitude)"
    $msg += "Timestamp: $($LocationInfo.Timestamp)"
    $msg += "Resolved Address: $($LocationInfo.ResolvedAddress)"
    $msg += "Google Maps Link: $($LocationInfo.GoogleMapsUrl)"
    $msg += ""
    return $msg
}
# Event Log Configuration
$EventSource = "ScheduledGeoWatcher"
$EventLog = "Application"
$EventId = 2001

# Ensure event source exists
if (-not [System.Diagnostics.EventLog]::SourceExists($EventSource)) {
    [System.Diagnostics.EventLog]::CreateEventSource($EventSource, $EventLog)
}

# Diagnostics check
function DiagCheck {
    param(
        [Parameter(Mandatory=$true)] [bool]$LocationEnabled,
        [Parameter(Mandatory=$true)] [bool]$WifiEnabled
    )
    # SSID count and Wi-Fi status
    $ssidCount = 0
    $wifiStatus = 'Not available or disabled'
    # Validate Wi-Fi status using netsh output parsing (Python logic)
    try {
        $netshResult = netsh wlan show interfaces 2>$null
        if ($netshResult) {
            $lines = $netshResult -split "`n"
            for ($i = 0; $i -lt $lines.Length; $i++) {
                if ($lines[$i] -match 'Radio status') {
                    for ($j = $i+1; $j -lt [Math]::Min($i+11, $lines.Length); $j++) {
                        $l = $lines[$j].Trim()
                        if ($l.ToLower().StartsWith('software')) {
                            if ($l -match ':') {
                                $radio_sw = $l.Split(':',2)[1].Trim()
                            } else {
                                $radio_sw = $l.Split()[1].Trim()
                            }
                            if ($radio_sw -eq 'On') {
                                $wifiStatus = 'Enabled/Available'
                            } else {
                                $wifiStatus = 'Not available or disabled'
                            }
                            break
                        }
                    }
                    break
                }
            }
        }
        # If Wi-Fi is enabled, count visible SSIDs
        if ($wifiStatus -eq 'Enabled/Available') {
            try {
                $netshNetworks = netsh wlan show networks 2>$null
                if ($netshNetworks) {
                    $ssidCount = ($netshNetworks | Select-String -Pattern '^SSID\s+\d+\s+:' | Measure-Object).Count
                }
            } catch { $ssidCount = 0 }
        }
    } catch { $wifiStatus = 'Not available or disabled'; $ssidCount = 0 }

    # Airplane mode status
    $radioReg = 'HKLM:\\System\\CurrentControlSet\\Control\\RadioManagement\\SystemRadioState'
    $airplaneOn = $false
    if (Test-Path $radioReg) {
        $reg = Get-ItemProperty -Path $radioReg -ErrorAction SilentlyContinue
        $val = $null
        if ($null -ne $reg) {
            if ($reg.PSObject.Properties.Name -contains '(default)') {
                $val = $reg.'(default)'
            } elseif ($reg.PSObject.Properties.Name -contains '') {
                $val = $reg.''
            } else {
                $val = $null
            }
            if ($null -ne $val -and [int]$val -eq 1) {
                $airplaneOn = $true
            }
        }
    }
    $airplaneStatus = if ($airplaneOn) { 'Enabled' } else { 'Disabled' }

    # Location status (check registry)
    $locationReg = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\LocationAndSensors'
    $locationStatus = 'Unknown'
    if (Test-Path $locationReg) {
        $locRegVal = Get-ItemProperty -Path $locationReg -ErrorAction SilentlyContinue
        if ($null -ne $locRegVal -and $locRegVal.PSObject.Properties.Name -contains 'DisableLocation') {
            $disableLocation = $locRegVal.DisableLocation
            if ($disableLocation -eq 0) {
                $locationStatus = 'Enabled'
            } elseif ($disableLocation -eq 1) {
                $locationStatus = 'Disabled'
            } else {
                $locationStatus = 'Unknown'
            }
        } else {
            $locationStatus = 'Unknown'
        }
    } else {
        $locationStatus = 'Unknown'
    }

    # LetAppsAccessLocation status (check registry)
    $letAppsAccessLocationStatus = 'Key missing'
    $appPrivPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppPrivacy'
    if (Test-Path $appPrivPath) {
        $appProps = Get-ItemProperty -Path $appPrivPath -ErrorAction SilentlyContinue
        if ($null -ne $appProps -and $appProps.PSObject.Properties.Name -contains 'LetAppsAccessLocation') {
            $val = [int]$appProps.LetAppsAccessLocation
            if ($val -eq 1) {
                $letAppsAccessLocationStatus = 'Enabled'
            } elseif ($val -eq 0) {
                $letAppsAccessLocationStatus = 'Disabled'
            } else {
                $letAppsAccessLocationStatus = "Unknown ($val)"
            }
        } else {
            $letAppsAccessLocationStatus = 'Key missing'
        }
    }

    return @{
        LocationStatus = $locationStatus
        LetAppsAccessLocation = $letAppsAccessLocationStatus
        WifiStatus = $wifiStatus
        SsidCount = $ssidCount
        AirplaneStatus = $airplaneStatus
    }
}


# Ensure $locationEnabled and $wifiEnabled are Boolean
if ($null -eq $locationEnabled) { $locationEnabled = $false }
if ($null -eq $wifiEnabled) { $wifiEnabled = $false }

# Call DiagCheck and assign results
$diag = DiagCheck -LocationEnabled $locationEnabled -WifiEnabled $wifiEnabled
$locationStatus = $diag.LocationStatus
$letAppsAccessLocation = $diag.LetAppsAccessLocation
$wifiStatus = $diag.WifiStatus
$ssidCount = $diag.SsidCount
$airplaneStatus = $diag.AirplaneStatus


# Helper function to format diagnostics info
function Format-DiagnosticsInfo {
    param(
        [string]$LocationStatus,
        [string]$LetAppsAccessLocation,
        [string]$WifiStatus,
        [int]$SsidCount,
        [string]$AirplaneStatus
    )
    return @(
        "Diagnostics",
        "Location Services: $LocationStatus",
        "LetAppsAccessLocation: $LetAppsAccessLocation",
        "Wi-Fi Status: $WifiStatus",
        "Visible Network Count: $SsidCount",
        "Airplane Mode: $AirplaneStatus",
        ""
    )
}

$diagnosticsMsg = Format-DiagnosticsInfo -LocationStatus $locationStatus -LetAppsAccessLocation $letAppsAccessLocation -WifiStatus $wifiStatus -SsidCount $ssidCount -AirplaneStatus $airplaneStatus


# Get public IP address and ISP
function Get-PublicIP {
    try {
        $ipinfo = Invoke-RestMethod -Uri "https://ipinfo.io/json" -ErrorAction Stop
        $ip = $ipinfo.ip
        $isp = if ($ipinfo.org) { $ipinfo.org } else { "Unavailable" }
        return @{ IP = $ip; ISP = $isp }
    } catch {
        return @{ IP = "Unavailable"; ISP = "Unavailable" }
    }
}


# Get geolocation
function Get-Geolocation {
    try {
        Add-Type -AssemblyName System.Device
        $GeoLocator = New-Object System.Device.Location.GeoCoordinateWatcher
        $GeoLocator.Start()
        $TimeoutSeconds = 5
        $StartTime = Get-Date
        $IsReady = $false
        while ((Get-Date) -le ($StartTime).AddSeconds($TimeoutSeconds)) {
            if ($GeoLocator.Status -eq 'Ready') {
                $IsReady = $true
                break
            }
            Start-Sleep -Milliseconds 250
        }
        if ($IsReady) {
            $location = $GeoLocator.Position.Location
            if ($null -ne $location -and $location.IsUnknown -eq $false) {
                $latitude = $location.Latitude
                $longitude = $location.Longitude
                $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                $GeoLocator.Stop()
            } else {
                $latitude = "Unknown"
                $longitude = "Unknown"
                $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
            }
        } else {
            $latitude = "Unknown"
            $longitude = "Unknown"
            $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        }
    } catch {
        $latitude = "Unknown"
        $longitude = "Unknown"
        $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    }
    return @{ Latitude = $latitude; Longitude = $longitude; Timestamp = $timestamp }
}

# Call Get-Geolocation and assign results
$geoResult = Get-Geolocation
$latitude = $geoResult.Latitude
$longitude = $geoResult.Longitude
$timestamp = $geoResult.Timestamp


# Reverse geocode
function Get-ReverseGeocode {
    param(
        [Parameter(Mandatory=$true)] [string]$Latitude,
        [Parameter(Mandatory=$true)] [string]$Longitude
    )
    if ($Latitude -ne "Unknown" -and $Longitude -ne "Unknown") {
        try {
            $nominatimUrl = "https://nominatim.openstreetmap.org/reverse?format=json&lat=$Latitude&lon=$Longitude"
            $headers = @{ 'User-Agent' = 'PowerShell Script (Personal Use)' }
            $locationData = Invoke-RestMethod -Uri $nominatimUrl -Headers $headers -ErrorAction Stop
            $resolvedAddress = $locationData.display_name
            $googleMapsUrl = "https://www.google.com/maps?q=$Latitude,$Longitude"
        } catch {
            $resolvedAddress = "Address resolution failed (API error)."
            $googleMapsUrl = "https://www.google.com/maps?q=$Latitude,$Longitude"
        }
    } else {
        $resolvedAddress = "Unknown"
        $googleMapsUrl = "Unknown"
    }
    return @{ ResolvedAddress = $resolvedAddress; GoogleMapsUrl = $googleMapsUrl }
}


# Path for last_location.json
$lastLocDir = "C:\\temp"
$lastLocFile = "$lastLocDir\\last_location.json"

# Ensure directory exists
if (-not (Test-Path $lastLocDir)) {
    New-Item -Path $lastLocDir -ItemType Directory | Out-Null
}

# Get current public IP and ISP
$ipResult = Get-PublicIP
$publicIP = $ipResult.IP
$currentISP = $ipResult.ISP

# Check for last_location.json and compare IP
$runGeoLookup = $true
if (Test-Path $lastLocFile) {
    try {
        $lastLoc = Get-Content $lastLocFile -Raw | ConvertFrom-Json
        if ($null -ne $lastLoc -and $lastLoc.IP -eq $publicIP) {
            # IP is the same, output last_location.json contents to event log and skip geolocator
            $logMsg = Format-LocationInfo -SectionTitle "Current Location Info (from cache)" -LocationInfo $lastLoc
            $logMsg += $diagnosticsMsg
            $logMsg = $logMsg -join "`n"
            Write-EventLog -LogName $EventLog -Source $EventSource -EventId $EventId -EntryType Information -Message $logMsg
            $runGeoLookup = $false
        } elseif ($null -ne $lastLoc -and $lastLoc.IP -ne $publicIP) {
            $ipChanged = $true
        }
    } catch {
        $runGeoLookup = $true
    }
}

if ($runGeoLookup) {
    # If IP changed and previous location exists, log both previous and current location info
    if ($ipChanged -and $null -ne $lastLoc) {
        # Pull previous location info from last_location.json
        $prevLocHash = @{}
        foreach ($prop in $lastLoc.PSObject.Properties) { $prevLocHash[$prop.Name] = $prop.Value }
        $prevLocMsg = Format-LocationInfo -SectionTitle "Previous Location Info" -LocationInfo $prevLocHash

        # Run geolocator lookup and update file
        $geoResult = Get-Geolocation
        $latitude = $geoResult.Latitude
        $longitude = $geoResult.Longitude
        $timestamp = $geoResult.Timestamp

        $geoCodeResult = Get-ReverseGeocode -Latitude $latitude -Longitude $longitude
        $resolvedAddress = $geoCodeResult.ResolvedAddress
        $googleMapsUrl = $geoCodeResult.GoogleMapsUrl

        $currLocMsg = Format-LocationInfo -SectionTitle "Current Location Info" -LocationInfo @{IP=$publicIP;ISP=$currentISP;Latitude=$latitude;Longitude=$longitude;Timestamp=$timestamp;ResolvedAddress=$resolvedAddress;GoogleMapsUrl=$googleMapsUrl}

        $logMsg = @()
        $logMsg += $currLocMsg
        $logMsg += $prevLocMsg
        $logMsg += $diagnosticsMsg
        $logMsg = $logMsg -join "`n"

        $changeLog = "GeoWatcher-Location Change"
        # Ensure the custom event log exists (both log and source)
        if (-not [System.Diagnostics.EventLog]::Exists($changeLog)) {
            if ([System.Diagnostics.EventLog]::SourceExists($changeLog)) {
                [System.Diagnostics.EventLog]::DeleteEventSource($changeLog)
            }
            New-EventLog -LogName $changeLog -Source $changeLog
        }
            Write-EventLog -LogName $changeLog -Source $changeLog -EventId 2002 -EntryType Information -Message $logMsg

        # Write results to last_location.json
        $jsonObj = [PSCustomObject]@{
            IP = $publicIP
            ISP = $currentISP
            Latitude = $latitude
            Longitude = $longitude
            Timestamp = $timestamp
            ResolvedAddress = $resolvedAddress
            GoogleMapsUrl = $googleMapsUrl
        }
        $jsonObj | ConvertTo-Json | Set-Content $lastLocFile
    } else {
        # Run geolocator lookup as normal
        $geoResult = Get-Geolocation
        $latitude = $geoResult.Latitude
        $longitude = $geoResult.Longitude
        $timestamp = $geoResult.Timestamp

        $geoCodeResult = Get-ReverseGeocode -Latitude $latitude -Longitude $longitude
        $resolvedAddress = $geoCodeResult.ResolvedAddress
        $googleMapsUrl = $geoCodeResult.GoogleMapsUrl

        # Always log current location info and diagnostics
        $logMsg = Format-LocationInfo -SectionTitle "Current Location Info" -LocationInfo @{IP=$publicIP;ISP=$currentISP;Latitude=$latitude;Longitude=$longitude;Timestamp=$timestamp;ResolvedAddress=$resolvedAddress;GoogleMapsUrl=$googleMapsUrl}
        $logMsg += $diagnosticsMsg
        $logMsg = $logMsg -join "`n"
        Write-EventLog -LogName $EventLog -Source $EventSource -EventId $EventId -EntryType Information -Message $logMsg

        # Write results to last_location.json
        $jsonObj = [PSCustomObject]@{
            IP = $publicIP
            ISP = $currentISP
            Latitude = $latitude
            Longitude = $longitude
            Timestamp = $timestamp
            ResolvedAddress = $resolvedAddress
            GoogleMapsUrl = $googleMapsUrl
        }
        $jsonObj | ConvertTo-Json | Set-Content $lastLocFile
    }
}
